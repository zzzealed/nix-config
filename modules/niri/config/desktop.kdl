// Left monitor
output "DP-2" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
    position x=0 y=0
}
// Middle monitor
output "DP-1" {
    mode "1920x1080@240"
    scale 1
    transform "normal"
    position x=1920 y=0
    focus-at-startup
}
output "HDMI-A-1" {
    mode "3840x2160@60"
    scale 3
    transform "normal"
    position x=3840 y=0
}

spawn-at-startup "opendeck" "--hide"
